# Local .terraform directories
**/.terraform/*
.terraform*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
# Local .terraform directories
**/.terraform/*
.terraform*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore tfplan files
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignored documents
PRD (3).md

# Python
__pycache__/
*.pyc
*.pyo
venv/

# Local Testing
mock_tfplan.json
risk-brief/

# Ignore SSH keys stored in project folder
ssh-keys/
*.pem
*.pub

# Ignore static Ansible inventory (contains real server IPs)
ansible/inventory/hosts.ini

# Ignore local troubleshooting logs
CI_CD_TROUBLESHOOTING.md
venv/*
risk-brief/