pipeline {
    agent any

    environment {
        // AWS Credentials - configure these in Jenkins > Manage Jenkins > Credentials
        // Kind: Secret text | ID: aws-access-key-id / aws-secret-access-key
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_DEFAULT_REGION    = 'ap-south-1'
        
        // Secret Files uploaded to Jenkins
        TF_VARS_FILE  = credentials('dev-tfvars')
        PUB_KEY_FILE  = credentials('aws-infra-key.pub')
        PRIV_KEY_FILE = credentials('aws-infra-key') // Your Private Key!
        
        // Pass AWS credentials from Windows into WSL Linux automatically!
        WSLENV = 'AWS_ACCESS_KEY_ID/u:AWS_SECRET_ACCESS_KEY/u:AWS_DEFAULT_REGION/u'
    }

    stages {

        stage('Terraform Validate') {
            steps {
                dir('terraform/environments/dev') {
                    // Validate syntax without connecting to S3 backend
                    bat 'M:/tools/terraform.exe init -backend=false'
                    bat 'M:/tools/terraform.exe validate'
                }
            }
        }

        stage('Terraform Plan (Dev)') {
            steps {
                dir('terraform/environments/dev') {
                    bat 'M:/tools/terraform.exe init'
                    bat 'M:/tools/terraform.exe plan -var-file="%TF_VARS_FILE%" -var="public_key_path=%PUB_KEY_FILE%" -out=tfplan'
                    bat 'M:/tools/terraform.exe show -no-color tfplan > tfplan.txt'
                }
            }
        }

        stage('Deploy to Dev') {
            when {
                expression { env.GIT_BRANCH == 'origin/dev' || env.GIT_BRANCH == 'dev' }
            }
            steps {
                dir('terraform/environments/dev') {
                    bat 'M:/tools/terraform.exe apply -auto-approve tfplan'
                }
                dir('ansible') {
                    // 1. Copy repo to native Linux filesystem to fix 777 world-writable permission errors
                    bat 'wsl rm -rf /tmp/aws-infra'
                    bat 'wsl cp -r ../ /tmp/aws-infra'
                    
                    // 2. Inject the Jenkins Secret Private Key into Linux (it wasn't in GitHub!)
                    bat 'wsl mkdir -p /tmp/aws-infra/ssh-keys'
                    bat 'wsl bash -c "cp $(wslpath \'%PRIV_KEY_FILE%\') /tmp/aws-infra/ssh-keys/aws-infra-key"'
                    bat 'wsl chmod 400 /tmp/aws-infra/ssh-keys/aws-infra-key'
                    
                    // 3. Run Ansible from inside the native Linux filesystem
                    bat 'wsl bash -c "cd /tmp/aws-infra/ansible && ansible-playbook playbooks/server_update.yml -i inventory/aws_ec2.yml -l tag_Environment_dev"'
                    bat 'wsl bash -c "cd /tmp/aws-infra/ansible && ansible-playbook playbooks/install_services.yml -i inventory/aws_ec2.yml -l tag_Environment_dev"'
                }
            }
        }

//         stage('Deploy to Staging') {
//             when {
//                 branch 'staging' // Only auto-apply on the staging branch
//             }
//             steps {
//                 dir('terraform/environments/staging') {
//                     sh 'terraform init'
//                     sh 'terraform apply -auto-approve'
//                 }
//                 dir('ansible') {
//                     sh 'ansible-playbook playbooks/install_services.yml -i inventory/aws_ec2.yml -l tag_Environment_staging'
//                 }
//             }
//         }

//         stage('Approval Gate: Prod') {
//             when {
//                 branch 'main' // Prod gate only triggers on main branch
//             }
//             steps {
//                 input message: "Approve deployment to PRODUCTION?", ok: "Deploy"
//             }
//         }

//         stage('Deploy to Prod') {
//             when {
//                 branch 'main'
//             }
//             steps {
//                 dir('terraform/environments/prod') {
//                     sh 'terraform init'
//                     sh 'terraform apply -auto-approve'
//                 }
//                 dir('ansible') {
