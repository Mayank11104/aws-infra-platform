//                     sh 'ansible-playbook playbooks/install_services.yml -i inventory/aws_ec2.yml -l tag_Environment_staging'
//                 }
//             }
//         }

//         stage('Approval Gate: Prod') {
//             when {
//                 branch 'main' // Prod gate only triggers on main branch
//             }
//             steps {
//                 input message: "Approve deployment to PRODUCTION?", ok: "Deploy"
//             }
//         }

//         stage('Deploy to Prod') {
//             when {
//                 branch 'main'
//             }
//             steps {
//                 dir('terraform/environments/prod') {
//                     sh 'terraform init'
//                     sh 'terraform apply -auto-approve'
//                 }
//                 dir('ansible') {
//                     sh 'ansible-playbook playbooks/install_services.yml -i inventory/aws_ec2.yml -l tag_Environment_prod'
//                 }
//             }
//         }
     }
}
