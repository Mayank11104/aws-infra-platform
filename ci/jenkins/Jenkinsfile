pipeline {
    agent any

    environment {
        // AWS Credentials - configure these in Jenkins > Manage Jenkins > Credentials
        // Kind: Secret text | ID: aws-access-key-id / aws-secret-access-key
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_DEFAULT_REGION    = 'ap-south-1'
        
        // Secret Files uploaded to Jenkins
        TF_VARS_FILE  = credentials('dev-tfvars')
        PUB_KEY_FILE  = credentials('aws-infra-key.pub')
        PRIV_KEY_FILE = credentials('aws-infra-key') // Your Private Key!
        
        // Pass AWS credentials from Windows into WSL Linux automatically!
        WSLENV = 'AWS_ACCESS_KEY_ID/u:AWS_SECRET_ACCESS_KEY/u:AWS_DEFAULT_REGION/u'
        
        // Force Python to use UTF-8 encoding for console output to prevent emoji crash
        PYTHONIOENCODING = 'utf-8'
    }

    stages {

        stage('Terraform Validate') {
            steps {
                dir('terraform/environments/dev') {
                    // Validate syntax without connecting to S3 backend
                    bat 'M:/tools/terraform.exe init -backend=false'
                    bat 'M:/tools/terraform.exe validate'
                }
            }
        }

        stage('Terraform Plan (Dev)') {
            when {
                expression { env.GIT_BRANCH == 'origin/dev' || env.GIT_BRANCH == 'dev' }
            }
            steps {
                dir('terraform/environments/dev') {
                    bat 'M:/tools/terraform.exe init'
                    bat 'M:/tools/terraform.exe plan -var-file="%TF_VARS_FILE%" -var="public_key_path=%PUB_KEY_FILE%" -out=tfplan'
                    bat 'M:/tools/terraform.exe show -no-color tfplan > tfplan.txt'
                    // IMPORTANT: Generate JSON for the AI Risk Gate
                    bat 'M:/tools/terraform.exe show -json tfplan > tfplan.json'
                }
            }
        }

        stage('AI Risk Gate') {
            when {
                expression { env.GIT_BRANCH == 'origin/dev' || env.GIT_BRANCH == 'dev' }
            }
            steps {
                script {
                    def ai_exit_code = 0

                    // -- Step 1: Run the AI agents (Account B + Neo4j) ----------
                    withCredentials([
                        string(credentialsId: 'bedrock-access-key', variable: 'BEDROCK_AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'bedrock-secret-key', variable: 'BEDROCK_AWS_SECRET_ACCESS_KEY'),
                        string(credentialsId: 'neo4j-uri', variable: 'NEO4J_URI'),
                        string(credentialsId: 'neo4j-user', variable: 'NEO4J_USER'),
                        string(credentialsId: 'neo4j-password', variable: 'NEO4J_PASSWORD')
                    ]) {
                        // Setup Python virtual environment (skip creation if it already exists)
                        bat 'if not exist venv\\Scripts\\python.exe python -m venv venv'
                        bat '.\\venv\\Scripts\\pip install -r agents/requirements.txt'

                        // Agents run, enrich with Neo4j history, generate audit-report/report.md, save to graph, then exit.
                        ai_exit_code = bat(
                            script: '.\\venv\\Scripts\\python -m agents.run_analysis --tfplan-json terraform/environments/dev/tfplan.json --env dev --run-id %BUILD_ID%',
                            returnStatus: true
                        )
                    }

                    // -- Step 2: Email the Infrastructure Audit Report to the admin ---------------------
                    // Jenkins Email Extension Plugin must be configured:
                    //   Manage Jenkins -> Configure System -> Extended E-mail Notification
                    //   Set SMTP server (e.g. smtp.gmail.com:587, TLS enabled)
                    //   Add your Gmail App Password as a Jenkins credential
                    def riskLevel = ai_exit_code == 0 ? "LOW RISK" : ai_exit_code == 2 ? "REVIEW REQUIRED" : "ERROR"
                    emailext(
                        to: 'mayuchaudhari2004@gmail.com', // <- Admin email
                        from: 'AI Risk Gate <mayuchaudhari2004@gmail.com>',
                        subject: "[Jenkins] Infrastructure Audit Report - Build #${BUILD_ID} (${riskLevel})",
                        body: """
                            <h2>Infrastructure Audit Report</h2>
                            <p><b>Pipeline:</b> ${JOB_NAME} #${BUILD_ID}</p>
                            <p><b>AI Recommendation:</b> ${riskLevel}</p>
                            <p>The full Audit Report is attached. Please review it and then either
                            <b>Approve</b> or <b>Abort</b> the pipeline from the Jenkins UI:</p>
                            <p><a href="${BUILD_URL}input">${BUILD_URL}input</a></p>
                            <p><i>The agents are advisory only - you make the final decision.</i></p>
                        """,
                        mimeType: 'text/html',
                        attachmentsPattern: 'audit-report/report.pdf',
                        attachLog: false
                    )

                    if (ai_exit_code == 1) {
                        error("AI Risk Gate encountered an error. Deployment blocked. Check the report.")
                    }

                    // -- Step 3: Archive the report as a Jenkins artifact --------------
                    archiveArtifacts artifacts: 'audit-report/report.pdf', allowEmptyArchive: false
                }
            }
        }

        // -- Manual Approval Gate -------------------------------------------------
        stage('Manual Approval') {
            when {
                expression { env.GIT_BRANCH == 'origin/dev' || env.GIT_BRANCH == 'dev' }
            }
            steps {
                script {
                    def approvalUser = "jenkins"
                    try {
                        def userInput = input(
                            message: "Infrastructure Audit Report has been emailed to you. Review it and decide:",
                            ok: "Approved - Proceed to Apply",
                            submitterParameter: 'approver',
                            parameters: [
                                text(name: 'APPROVAL_REASON', defaultValue: '', description: 'Optional: Why are you approving this?')
                            ]
                        )
                        approvalUser = userInput['approver'] ?: "unknown"
                    } catch (err) {
                        // Pipeline aborted by human
                        withCredentials([
                            string(credentialsId: 'neo4j-uri', variable: 'NEO4J_URI'),
                            string(credentialsId: 'neo4j-user', variable: 'NEO4J_USER'),
                            string(credentialsId: 'neo4j-password', variable: 'NEO4J_PASSWORD')
                        ]) {
                            bat ".\\venv\\Scripts\\python -m agents.run_graph_update --action approval --run-id %BUILD_ID% --decision rejected --user unknown"
                        }
                        error("Deployment rejected by human approver.")
                    }

                    // If we reach here, it was approved.
                    withCredentials([
                        string(credentialsId: 'neo4j-uri', variable: 'NEO4J_URI'),
                        string(credentialsId: 'neo4j-user', variable: 'NEO4J_USER'),
                        string(credentialsId: 'neo4j-password', variable: 'NEO4J_PASSWORD')
                    ]) {
                        bat ".\\venv\\Scripts\\python -m agents.run_graph_update --action approval --run-id %BUILD_ID% --decision approved --user ${approvalUser}"
                    }
                }
            }
        }


        stage('Deploy to Dev') {
            when {
                expression { env.GIT_BRANCH == 'origin/dev' || env.GIT_BRANCH == 'dev' }
            }
            steps {
                dir('terraform/environments/dev') {
                    bat 'M:/tools/terraform.exe apply -auto-approve tfplan'
                }
                dir('ansible') {
                    // 1. Copy ansible dir to native Linux filesystem to fix 777 world-writable permission errors
                    bat 'wsl rm -rf /tmp/aws-infra'
                    bat 'wsl mkdir -p /tmp/aws-infra'
                    bat 'wsl cp -r . /tmp/aws-infra/ansible'
                    
                    // 2. Inject the Jenkins Secret Private Key into Linux (using the PRIV_KEY_FILE from env)
                    bat 'wsl mkdir -p ~/.ssh'
                    bat 'wsl bash -c "cp \\"$(wslpath \'%PRIV_KEY_FILE%\')\\" ~/.ssh/id_rsa"'
                    bat 'wsl chmod 600 ~/.ssh/id_rsa'
                    
                    // 3. Run ansible from Linux directly
                    bat 'wsl bash -c "cd /tmp/aws-infra/ansible && ansible-playbook playbooks/install_services.yml -i inventory/aws_ec2.yml -l tag_Environment_dev"'
                    
                    // 4. (Phase 3) Write Ansible state back to Knowledge Graph
                    withCredentials([
                        string(credentialsId: 'neo4j-uri', variable: 'NEO4J_URI'),
                        string(credentialsId: 'neo4j-user', variable: 'NEO4J_USER'),
                        string(credentialsId: 'neo4j-password', variable: 'NEO4J_PASSWORD')
                    ]) {
                        // Hardcoding the update for the lab. In prod, you'd parse ansible JSON output.
                        bat "set PYTHONPATH=..&& .\\..\\venv\\Scripts\\python -m agents.run_graph_update --action ansible --env dev --run-id %BUILD_ID% --playbook install_services.yml --role nginx --host-group tag_Role_web --addresses module.ec2.aws_instance.web[0]"
                        bat "set PYTHONPATH=..&& .\\..\\venv\\Scripts\\python -m agents.run_graph_update --action ansible --env dev --run-id %BUILD_ID% --playbook install_services.yml --role docker --host-group tag_Role_web --addresses module.ec2.aws_instance.web[0]"
                    }
                }
            }
        }

        // ── STAGING ────────────────────────────────────────────────────────────

        stage('Terraform Plan (Staging)') {
            when {
                expression { env.GIT_BRANCH == 'origin/staging' || env.GIT_BRANCH == 'staging' }
            }
            steps {
                withCredentials([file(credentialsId: 'staging-tfvars', variable: 'STAGING_VARS_FILE')]) {
                    dir('terraform/environments/staging') {
                        bat 'M:/tools/terraform.exe init'
                        bat 'M:/tools/terraform.exe plan -var-file="%STAGING_VARS_FILE%" -var="public_key_path=%PUB_KEY_FILE%" -out=tfplan'
                        bat 'M:/tools/terraform.exe show -no-color tfplan > tfplan.txt'
                        bat 'M:/tools/terraform.exe show -json tfplan > tfplan.json'
                    }
                }
            }
        }

        stage('AI Risk Gate (Staging)') {
            when {
                expression { env.GIT_BRANCH == 'origin/staging' || env.GIT_BRANCH == 'staging' }
            }
            steps {
                script {
                    def ai_exit_code = 0
                    withCredentials([
                        string(credentialsId: 'bedrock-access-key', variable: 'BEDROCK_AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'bedrock-secret-key', variable: 'BEDROCK_AWS_SECRET_ACCESS_KEY'),
                        string(credentialsId: 'neo4j-uri', variable: 'NEO4J_URI'),
                        string(credentialsId: 'neo4j-user', variable: 'NEO4J_USER'),
                        string(credentialsId: 'neo4j-password', variable: 'NEO4J_PASSWORD')
                    ]) {
                        bat 'if not exist venv\\Scripts\\python.exe python -m venv venv'
                        bat '.\\venv\\Scripts\\pip install -r agents/requirements.txt'
                        ai_exit_code = bat(
                            script: '.\\venv\\Scripts\\python -m agents.run_analysis --tfplan-json terraform/environments/staging/tfplan.json --env staging --run-id %BUILD_ID%',
                            returnStatus: true
                        )
                    }
                    def riskLevel = ai_exit_code == 0 ? "LOW RISK" : ai_exit_code == 2 ? "REVIEW REQUIRED" : "ERROR"
                    emailext(
                        to: 'mayuchaudhari2004@gmail.com',
                        from: 'AI Risk Gate <mayuchaudhari2004@gmail.com>',
                        subject: "[Jenkins] STAGING — Audit Report - Build #${BUILD_ID} (${riskLevel})",
                        body: """
                            <h2>Infrastructure Audit Report — STAGING</h2>
                            <p><b>Pipeline:</b> ${JOB_NAME} #${BUILD_ID}</p>
                            <p><b>AI Recommendation:</b> ${riskLevel}</p>
                            <p>Review and approve/abort: <a href="${BUILD_URL}input">${BUILD_URL}input</a></p>
                        """,
                        mimeType: 'text/html',
                        attachmentsPattern: 'audit-report/report.pdf',
                        attachLog: false
                    )
                    if (ai_exit_code == 1) {
                        error("AI Risk Gate (Staging) encountered an error. Deployment blocked.")
                    }
                    archiveArtifacts artifacts: 'audit-report/report.pdf', allowEmptyArchive: false
                }
            }
        }

        stage('Manual Approval (Staging)') {
            when {
                expression { env.GIT_BRANCH == 'origin/staging' || env.GIT_BRANCH == 'staging' }
            }
            steps {
                script {
                    def approvalUser = "jenkins"
                    try {
                        def userInput = input(
                            message: "Approve deployment to STAGING? Review the audit report first.",
                            ok: "Approved - Deploy to Staging",
                            submitterParameter: 'approver',
                            parameters: [
                                text(name: 'APPROVAL_REASON', defaultValue: '', description: 'Optional: Why are you approving?')
                            ]
                        )
                        approvalUser = userInput['approver'] ?: "unknown"
                    } catch (err) {
                        withCredentials([
                            string(credentialsId: 'neo4j-uri', variable: 'NEO4J_URI'),
                            string(credentialsId: 'neo4j-user', variable: 'NEO4J_USER'),
                            string(credentialsId: 'neo4j-password', variable: 'NEO4J_PASSWORD')
                        ]) {
                            bat ".\\venv\\Scripts\\python -m agents.run_graph_update --action approval --run-id %BUILD_ID% --decision rejected --user unknown"
                        }
                        error("Staging deployment rejected by human approver.")
                    }
                    withCredentials([
                        string(credentialsId: 'neo4j-uri', variable: 'NEO4J_URI'),
                        string(credentialsId: 'neo4j-user', variable: 'NEO4J_USER'),
                        string(credentialsId: 'neo4j-password', variable: 'NEO4J_PASSWORD')
                    ]) {
                        bat ".\\venv\\Scripts\\python -m agents.run_graph_update --action approval --run-id %BUILD_ID% --decision approved --user ${approvalUser}"
                    }
                }
            }
        }

        stage('Deploy to Staging') {
            when {
                expression { env.GIT_BRANCH == 'origin/staging' || env.GIT_BRANCH == 'staging' }
            }
            steps {
                dir('terraform/environments/staging') {
                    bat 'M:/tools/terraform.exe apply -auto-approve tfplan'
                }
                dir('ansible') {
                    bat 'wsl rm -rf /tmp/aws-infra'
                    bat 'wsl mkdir -p /tmp/aws-infra'
                    bat 'wsl cp -r . /tmp/aws-infra/ansible'
                    bat 'wsl mkdir -p ~/.ssh'
                    bat 'wsl bash -c "cp \\"$(wslpath \'%PRIV_KEY_FILE%\')\\" ~/.ssh/id_rsa"'
                    bat 'wsl chmod 600 ~/.ssh/id_rsa'
                    bat 'wsl bash -c "cd /tmp/aws-infra/ansible && ansible-playbook playbooks/install_services.yml -i inventory/aws_ec2.yml -l tag_Environment_staging"'
                    withCredentials([
                        string(credentialsId: 'neo4j-uri', variable: 'NEO4J_URI'),
                        string(credentialsId: 'neo4j-user', variable: 'NEO4J_USER'),
                        string(credentialsId: 'neo4j-password', variable: 'NEO4J_PASSWORD')
                    ]) {
                        bat "set PYTHONPATH=..&& .\\..\\venv\\Scripts\\python -m agents.run_graph_update --action ansible --env staging --run-id %BUILD_ID% --playbook install_services.yml --role nginx --host-group tag_Role_web --addresses module.ec2.aws_instance.web[0]"
                        bat "set PYTHONPATH=..&& .\\..\\venv\\Scripts\\python -m agents.run_graph_update --action ansible --env staging --run-id %BUILD_ID% --playbook install_services.yml --role docker --host-group tag_Role_web --addresses module.ec2.aws_instance.web[0]"
                    }
                }
            }
        }

        // ── PRODUCTION ─────────────────────────────────────────────────────────

        stage('Terraform Plan (Prod)') {
            when {
                expression { env.GIT_BRANCH == 'origin/main' || env.GIT_BRANCH == 'main' }
            }
            steps {
                withCredentials([file(credentialsId: 'prod-tfvars', variable: 'PROD_VARS_FILE')]) {
                    dir('terraform/environments/prod') {
                        bat 'M:/tools/terraform.exe init'
                        bat 'M:/tools/terraform.exe plan -var-file="%PROD_VARS_FILE%" -var="public_key_path=%PUB_KEY_FILE%" -out=tfplan'
                        bat 'M:/tools/terraform.exe show -no-color tfplan > tfplan.txt'
                        bat 'M:/tools/terraform.exe show -json tfplan > tfplan.json'
                    }
                }
            }
        }

        stage('AI Risk Gate (Prod)') {
            when {
                expression { env.GIT_BRANCH == 'origin/main' || env.GIT_BRANCH == 'main' }
            }
            steps {
                script {
                    def ai_exit_code = 0
                    withCredentials([
                        string(credentialsId: 'bedrock-access-key', variable: 'BEDROCK_AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'bedrock-secret-key', variable: 'BEDROCK_AWS_SECRET_ACCESS_KEY'),
                        string(credentialsId: 'neo4j-uri', variable: 'NEO4J_URI'),
                        string(credentialsId: 'neo4j-user', variable: 'NEO4J_USER'),
                        string(credentialsId: 'neo4j-password', variable: 'NEO4J_PASSWORD')
                    ]) {
                        bat 'if not exist venv\\Scripts\\python.exe python -m venv venv'
                        bat '.\\venv\\Scripts\\pip install -r agents/requirements.txt'
                        ai_exit_code = bat(
                            script: '.\\venv\\Scripts\\python -m agents.run_analysis --tfplan-json terraform/environments/prod/tfplan.json --env prod --run-id %BUILD_ID%',
                            returnStatus: true
                        )
                    }
                    def riskLevel = ai_exit_code == 0 ? "LOW RISK" : ai_exit_code == 2 ? "REVIEW REQUIRED" : "ERROR"
                    emailext(
                        to: 'mayuchaudhari2004@gmail.com',
                        from: 'AI Risk Gate <mayuchaudhari2004@gmail.com>',
                        subject: "[Jenkins] ⚠️ PRODUCTION — Audit Report - Build #${BUILD_ID} (${riskLevel})",
                        body: """
                            <h2>⚠️ Infrastructure Audit Report — PRODUCTION</h2>
                            <p><b>Pipeline:</b> ${JOB_NAME} #${BUILD_ID}</p>
                            <p><b>AI Recommendation:</b> ${riskLevel}</p>
                            <p><b>This is a PRODUCTION deployment. Review the full audit report carefully before approving.</b></p>
                            <p>Review and approve/abort: <a href="${BUILD_URL}input">${BUILD_URL}input</a></p>
                        """,
                        mimeType: 'text/html',
                        attachmentsPattern: 'audit-report/report.pdf',
                        attachLog: false
                    )
                    if (ai_exit_code == 1) {
                        error("AI Risk Gate (Prod) encountered an error. Deployment blocked.")
                    }
                    archiveArtifacts artifacts: 'audit-report/report.pdf', allowEmptyArchive: false
                }
            }
        }

        stage('Manual Approval (Prod)') {
            when {
                expression { env.GIT_BRANCH == 'origin/main' || env.GIT_BRANCH == 'main' }
            }
            steps {
                script {
                    def approvalUser = "jenkins"
                    // Production has a 4-hour timeout — longer than dev/staging
                    timeout(time: 4, unit: 'HOURS') {
                        try {
                            def userInput = input(
                                message: "⚠️ PRODUCTION DEPLOYMENT — This affects live infrastructure. Are you sure?",
                                ok: "YES — Approved for Production",
                                submitterParameter: 'approver',
                                parameters: [
                                    text(name: 'APPROVAL_REASON', defaultValue: '', description: 'Required: State your reason for approving this production deployment.')
                                ]
                            )
                            approvalUser = userInput['approver'] ?: "unknown"
                        } catch (err) {
                            withCredentials([
                                string(credentialsId: 'neo4j-uri', variable: 'NEO4J_URI'),
                                string(credentialsId: 'neo4j-user', variable: 'NEO4J_USER'),
                                string(credentialsId: 'neo4j-password', variable: 'NEO4J_PASSWORD')
                            ]) {
                                bat ".\\venv\\Scripts\\python -m agents.run_graph_update --action approval --run-id %BUILD_ID% --decision rejected --user unknown"
                            }
                            error("Production deployment rejected or timed out.")
                        }
                    }
                    withCredentials([
                        string(credentialsId: 'neo4j-uri', variable: 'NEO4J_URI'),
                        string(credentialsId: 'neo4j-user', variable: 'NEO4J_USER'),
                        string(credentialsId: 'neo4j-password', variable: 'NEO4J_PASSWORD')
                    ]) {
                        bat ".\\venv\\Scripts\\python -m agents.run_graph_update --action approval --run-id %BUILD_ID% --decision approved --user ${approvalUser}"
                    }
                }
            }
        }

        stage('Deploy to Prod') {
            when {
                expression { env.GIT_BRANCH == 'origin/main' || env.GIT_BRANCH == 'main' }
            }
            steps {
                dir('terraform/environments/prod') {
                    bat 'M:/tools/terraform.exe apply -auto-approve tfplan'
                }
                dir('ansible') {
                    bat 'wsl rm -rf /tmp/aws-infra'
                    bat 'wsl mkdir -p /tmp/aws-infra'
                    bat 'wsl cp -r . /tmp/aws-infra/ansible'
                    bat 'wsl mkdir -p ~/.ssh'
                    bat 'wsl bash -c "cp \\"$(wslpath \'%PRIV_KEY_FILE%\')\\" ~/.ssh/id_rsa"'
                    bat 'wsl chmod 600 ~/.ssh/id_rsa'
                    bat 'wsl bash -c "cd /tmp/aws-infra/ansible && ansible-playbook playbooks/install_services.yml -i inventory/aws_ec2.yml -l tag_Environment_prod"'
                    withCredentials([
                        string(credentialsId: 'neo4j-uri', variable: 'NEO4J_URI'),
                        string(credentialsId: 'neo4j-user', variable: 'NEO4J_USER'),
                        string(credentialsId: 'neo4j-password', variable: 'NEO4J_PASSWORD')
                    ]) {
                        bat "set PYTHONPATH=..&& .\\..\\venv\\Scripts\\python -m agents.run_graph_update --action ansible --env prod --run-id %BUILD_ID% --playbook install_services.yml --role nginx --host-group tag_Role_web --addresses module.ec2.aws_instance.web[0]"
                        bat "set PYTHONPATH=..&& .\\..\\venv\\Scripts\\python -m agents.run_graph_update --action ansible --env prod --run-id %BUILD_ID% --playbook install_services.yml --role docker --host-group tag_Role_web --addresses module.ec2.aws_instance.web[0]"
                    }
                }
            }
        }

     }
}
